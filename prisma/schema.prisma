generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id            String    @default(cuid()) @id
  name          String?
  email         String    @unique
  password      String?
  credits       Int       @default(3)
  createdAt     DateTime  @default(now())
}